# =====================================================================
# Hanindo Group — Apache configuration
# ---------------------------------------------------------------------
# Upload this to public_html/ alongside the site. It does two jobs, both
# of which used to be manual steps on a checklist that was easy to miss:
#
#   1. Points Apache at the custom 404 page.
#   2. Redirects the old Joomla URLs to their new homes, so existing
#      Google results and anyone's bookmarks keep working.
#
# Generated from REDIRECTS.txt, which carries the reasoning behind each
# mapping. Edit that file and regenerate rather than editing this one by
# hand, so the two cannot drift apart.
# =====================================================================

# Without this Apache serves its own bare "Not Found" page and the
# site's 404.html is never used. 404.html deliberately uses absolute
# paths, because Apache serves it at whatever URL the visitor asked for.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Old Joomla URLs -> new paths.
#
# ORDER MATTERS. The longer /about-hanindo-group/* rules must stay above
# the bare /about-hanindo-group rule: Apache matches on prefix, so the
# short one would otherwise swallow all of them.
# ---------------------------------------------------------------------
Redirect 301 /about-hanindo-group/hanindo-citra                     /citra/
Redirect 301 /about-hanindo-group/flowtech-engineering              /flowtech-engineering/
Redirect 301 /about-hanindo-group/hanindo-automotive                /automotive/
Redirect 301 /about-hanindo-group/hanindo-automation-solutions      /automation/
Redirect 301 /about-hanindo-group/hanindo-overseas                  /shanghai/
Redirect 301 /about-hanindo-group                                   /about/
Redirect 301 /pt-hanindo-citra                                      /citra/
Redirect 301 /pt-flowtech-engineering                               /flowtech-engineering/
Redirect 301 /pt-hanindo-automotive                                 /automotive/
Redirect 301 /hanindo-automation-solutions                          /automation/
Redirect 301 /pt-hanindo-overseas                                   /shanghai/
Redirect 301 /hanindo-product                                       /
Redirect 301 /oil-and-gas                                           /citra/
Redirect 301 /home-automotive                                       /automotive/
Redirect 301 /partners-a-principals                                 /partners/

# ENABLED 2026-08-17, repointed. This was off because it aimed at
# /training/, which does not exist and never did, so it would have 301'd
# straight into a 404 — leaving it off was the right call at the time.
#
# It now goes to /products-services/ instead. The old page offered
# training on Gilbarco Veeder-Root equipment and on thermal printers, and
# nothing on the new site replaces it; that URL spans two product
# families, so the group products page is the one page covering both. Not
# ideal, but a real indexed URL now lands on what the group supplies with
# a route to the right company, rather than falling through to 404.html.
#
# The automotive spooring and balancing courses are the only training
# content on the site and belong to a different product line, so this
# must NOT be repointed there. If a /training/ page is ever built, aim
# this at it and update REDIRECTS.txt to match.
Redirect 301 /training-gilbarco-veeder-root-thermal-printer-indonesia /products-services/

Redirect 301 /news-info/career-hanindo-group-gilbarco-veeder-root-indonesia-thermal-printer /career/
Redirect 301 /contact-us                                            /contact/
Redirect 301 /overseas                                              /shanghai/
Redirect 301 /about                                                 /about/


# ---------------------------------------------------------------------
# Compression.
#
# The stylesheet alone is 111KB of text and was going over the wire
# uncompressed; gzip takes it to 33KB. Across the CSS, JS and a page of
# HTML that is 170KB down to 50KB on a first visit, which matters more
# than it looks on a phone connection.
#
# Both blocks are wrapped in IfModule on purpose: if the host does not
# have the module the directives are skipped rather than throwing a 500,
# and the site simply serves as it does today.
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Caching.
#
# Photographs and logos keep their filenames, and the stylesheet and the
# dictionaries carry a ?v= stamp that changes whenever they do, so both
# are safe to cache hard — a returning visitor re-downloads nothing.
#
# HTML is deliberately NOT cached long. The pages have no version stamp
# of their own, so a long cache would leave someone looking at an old
# copy after an update with no way to know.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/html               "access plus 10 minutes"
  ExpiresByType application/json        "access plus 1 hour"
</IfModule>
